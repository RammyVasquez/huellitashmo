# Copia este archivo a .env.local y llena los valores (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SOLO servidor. Nunca la pongas con prefijo NEXT_PUBLIC ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Dirección pública del sitio (para las tarjetas al compartir). En Vercel: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CAPTCHA (Cloudflare Turnstile, gratis). Para pruebas locales puedes usar las llaves de prueba de Cloudflare:
#   sitio 1x00000000000000000000AA  /  secreta 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Avisos al celular (Telegram). Crea un bot con @BotFather y obtén tu chat id (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Avisos por correo (opcional, Resend). El remitente debe ser de un dominio verificado
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
